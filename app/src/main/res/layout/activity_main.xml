<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="#090B16"
    android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:id="@+id/title" android:text="Galaxy" android:textColor="#F5F3FF"
        android:textSize="32sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/subtitle" android:text="让坚持留下轨迹" android:textColor="#9296AD"
        android:textSize="14sp" android:textLayout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:layout_marginTop="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/streak" android:background="@drawable/bg_card" android:textColor="#F5F3FF"
            android:textSize="18sp" android:gravity="center_vertical" android:padding="16dp"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="80dp"/>
        <Space android:layout_width="10dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/cards" android:background="@drawable/bg_card" android:textColor="#F5F3FF"
            android:textSize="18sp" android:gravity="center_vertical" android:padding="16dp"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="80dp"/>
    </LinearLayout>

    <TextView android:id="@+id/month" android:textColor="#F5F3FF" android:textSize="20sp"
        android:textStyle="bold" android:layout_marginTop="24dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <CalendarView android:id="@+id/calendar" android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/checkin" android:text="今天打卡" android:textAllCaps="false"
        android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="52dp"/>

    <Button android:id="@+id/makeup" android:text="给选中的漏签日期使用补签卡" android:textAllCaps="false"
        android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="52dp"/>

    <TextView android:id="@+id/stats" android:textColor="#9296AD" android:textSize="14sp"
        android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
